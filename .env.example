# Linear personal API key (Linear: Settings → Account → Security & Access).
# You can also set all of this in the app, under Settings.
# Leave empty to be asked for it on first open.
LINEAR_API_KEY=

# Team key, the prefix of your issue identifiers (ENG-123 → ENG). Empty = every team.
WTFWID_LINEAR_TEAM=

# Repositories to read pull requests from, comma separated.
WTFWID_GITHUB_REPOS=owner/repo

# Optional. Without it, wtfwid uses the token the GitHub CLI is logged in with (`gh auth token`).
GITHUB_TOKEN=

# Optional. Where remembered sessions are kept. Default: ~/.wtfwid
# WTFWID_HOME=

# Optional. Set to 1 and wtfwid never asks GitHub whether a newer version is out.
# WTFWID_NO_UPDATE_CHECK=1
