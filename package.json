{
	"name": "wtfwid",
	"private": true,
	"version": "0.1.1",
	"description": "What the f was I doing: tickets, Claude Code sessions and pull requests on one timeline.",
	"author": "vargaking",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"main": "electron/main.js",
	"desktopName": "wtfwid.desktop",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"spec": "node scripts/spec-check.js",
		"status": "node scripts/status.js",
		"start": "node start.js",
		"desktop": "vite build && electron .",
		"dist": "vite build && electron-builder"
	},
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"build": {
		"appId": "io.github.vargaking.wtfwid",
		"productName": "wtfwid",
		"directories": {
			"output": "dist",
			"buildResources": "electron/resources"
		},
		"files": [
			"build/**/*",
			"electron/*.js",
			"!electron/*.test.js",
			"electron/resources/tray*.png",
			"package.json"
		],
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development",
			"syncDesktopName": true
		},
		"mac": {
			"target": [
				"dmg"
			],
			"category": "public.app-category.developer-tools"
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
	}
}
